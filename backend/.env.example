# ─────────────────────────────────────────────────────────────────────────────
# Job Aggregator backend configuration
#
# Copy this file to `backend/.env` and adjust for your environment:
#   cp backend/.env.example backend/.env
#
# The `.env` file is git-ignored. The values below assume you run PostgreSQL and
# Redis through the root `docker-compose.yml` and run the backend natively on
# your machine (not inside Docker).
#
# NOTE: the hostnames `postgres` and `redis` only resolve *inside* the Docker
# network. From the host, always use 127.0.0.1 with the published ports.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — compose publishes 5433 on the host (see docker-compose.yml)
DATABASE_URL=postgresql://job_user:job_password@127.0.0.1:5433/job_automation

# Redis — compose publishes 6381 on the host (see docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6381/0

# Set to "true" to make startup fail hard when Redis is unreachable instead of
# falling back to the in-process memory cache.
CACHE_REQUIRE_REDIS=false

# Seconds a seen URL stays in the deduplication cache (default: 7 days)
# CACHE_TTL_SECONDS=604800

# Hours before the same job fingerprint can be stored again (default: 24)
# DEDUP_WINDOW_HOURS=24

# Google dork search — configure ONE of these. Leave both blank to disable it.
# The backend still works without them (you will see a startup warning).
SERPER_API_KEY=
SERPAPI_API_KEY=

# ─── Recency & ranking ───────────────────────────────────────────────────────
# Hard recency window for every job/post (hours).
POSTED_HOURS=24
# Drop items whose posting date cannot be parsed (recommended for a fresh feed).
STRICT_RECENT=true
# Only keep remote jobs/posts (hybrid & onsite are rejected).
REMOTE_ONLY=true
# Composite score weights (relevance + authenticity).
RELEVANCE_WEIGHT=0.6
AUTHENTICITY_WEIGHT=0.4

# ─── Social hiring posts (manual scans from the frontend) ────────────────────
# LinkedIn / X posts are scanned 2-3 times per day from the frontend, never by
# the hourly scheduler. Credentials can also live in ../auth-access.txt.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
X_USERNAME=
X_PASSWORD=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Optional Reddit "script" app (https://www.reddit.com/prefs/apps). When set,
# the collector uses the OAuth API (higher rate limits). Otherwise it reads the
# public Atom feeds (/r/<sub>/new/.rss), which need no login.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=forhire,jobbit,remotejobs,hiring
REDDIT_MAX_SUBREDDITS=3
REDDIT_REQUEST_DELAY=20
REDDIT_RATE_LIMIT_WAIT=40
SOCIAL_ENABLED=true
SOCIAL_MAX_POSTS_PER_PLATFORM=40
# Keep false the first time so you can complete any login challenge manually.
SOCIAL_HEADLESS=false
SOCIAL_NAV_TIMEOUT_MS=45000
# Max seconds an interactive "Open login browser" window may stay open.
SOCIAL_BROWSER_TIMEOUT=900

# ─── YC founder sourcing & outreach ──────────────────────────────────────────
# Crawls the public YC directory API + company/founder pages, collects X /
# LinkedIn / email contacts, drafts outreach, and sends only approved messages.
YC_ENABLED=true
# Batches are human-readable names accepted by api.ycombinator.com.
YC_BATCHES=Winter 2025,Spring 2025,Summer 2025,Fall 2025,Winter 2026,Spring 2026,Summer 2026,Fall 2026
YC_REQUEST_DELAY=1.2
# Safety caps (0 = unlimited). Useful for a first smoke test.
YC_MAX_COMPANIES_PER_BATCH=0
YC_MAX_PAGES_PER_BATCH=0
YC_DISCOVER_EMAILS=true
YC_MAX_WEBSITE_PAGES=3
# Max seconds spent enriching one company before moving on.
YC_COMPANY_TIME_BUDGET=120
YC_EMAIL_PATTERN_GUESS=true

# Outreach copy / signature
OUTREACH_ENABLED=true
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_COMPANY=
OUTREACH_SENDER_LINK=
OUTREACH_KEYWORDS=backend,python,devops,platform,ai,llm,full stack
OUTREACH_MAX_JOBS_IN_MESSAGE=3

# Per-run send caps (keep DMs low to avoid platform challenges)
OUTREACH_EMAIL_MAX_PER_RUN=50
OUTREACH_X_MAX_PER_RUN=20
OUTREACH_LINKEDIN_MAX_PER_RUN=10
OUTREACH_DM_MIN_DELAY=45
OUTREACH_DM_MAX_DELAY=120

# Email channel (SMTP). Leave blank to disable email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
